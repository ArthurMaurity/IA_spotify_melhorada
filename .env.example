# ---- Spotify (https://developer.spotify.com/dashboard) ----
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Must match EXACTLY a Redirect URI registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Where the OAuth token is cached (keep out of git).
SPOTIFY_CACHE_PATH=.cache-spotify

# ---- Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# ---- Google Sheets (optional; leave SHEETS_ENABLED=false to skip) ----
SHEETS_ENABLED=false
# Path to a service-account JSON key. Share the sheet with the account's email.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=SpotifyFlowLog
GOOGLE_WORKSHEET_NAME=history

# ---- Execution parameters ----
# Seconds between playback polls in Radio Mode.
POLL_INTERVAL=15
# Inject when the track has passed this fraction of its duration (0.66 = final third).
INJECT_THRESHOLD=0.66
# How many tracks of history to feed the AI.
CONTEXT_SIZE=5
# How many tracks to inject per trigger.
TRACKS_PER_INJECTION=2
# Local output files.
CSV_PATH=history.csv
SESSION_LOG_PATH=session_log.txt
